{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeQuest published question pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "version",
    "trails",
    "questions"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,59}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "trails": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "number",
          "name"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "topic",
          "subtopic",
          "difficulty",
          "questionType",
          "description",
          "examples",
          "constraints",
          "starterCode",
          "expectedAnswer",
          "options",
          "hints",
          "explanation",
          "xpReward",
          "isClassic",
          "tags",
          "trail",
          "order",
          "validator"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "subtopic": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          },
          "questionType": {
            "enum": [
              "MULTIPLE_CHOICE",
              "PREDICT_OUTPUT",
              "CODE_BLANK",
              "LOGIC_ANSWER",
              "CODING_CHALLENGE"
            ]
          },
          "description": {
            "type": "string"
          },
          "examples": {
            "type": "array"
          },
          "constraints": {
            "type": "array"
          },
          "starterCode": {
            "type": "string"
          },
          "expectedAnswer": {
            "type": "string"
          },
          "options": {
            "type": "array"
          },
          "hints": {
            "type": "array"
          },
          "explanation": {
            "type": "string"
          },
          "xpReward": {
            "enum": [
              10,
              20,
              30
            ]
          },
          "isClassic": {
            "type": "boolean"
          },
          "tags": {
            "type": "array"
          },
          "trail": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "validator": {
            "enum": [
              "OPTION",
              "TOKEN",
              "OUTPUT",
              "INTEGER",
              "INT_LIST",
              "INT_MATRIX"
            ]
          }
        }
      }
    }
  }
}
