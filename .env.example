# Copy to .env. Use new, random secrets; never reuse another project's values.
DB_URL=jdbc:mysql://localhost:3307/codequest
DB_USERNAME=codequest
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Local HTTP only. Production HTTPS must use true.
COOKIE_SECURE=false
# Match frontend/vite.config.js if changing the API port.
PORT=8085
BIND_ADDRESS=127.0.0.1
